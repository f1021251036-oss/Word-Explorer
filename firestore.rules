rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User Profile Validation
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'authProviders', 'learningPathway']) &&
        data.uid is string &&
        data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100 &&
        data.email is string &&
        data.authProviders is string &&
        data.learningPathway in ['LOW', 'MIDDLE', 'HIGH'] &&
        (!('photoURL' in data) || data.photoURL is string) &&
        (!('preferredLanguage' in data) || data.preferredLanguage is string) &&
        (!('accountStatus' in data) || data.accountStatus in ['ACTIVE', 'PENDING_VERIFICATION', 'SUSPENDED']) &&
        (!('createdAt' in data) || (data.createdAt is timestamp && data.createdAt <= request.time)) &&
        (!('lastLoginAt' in data) || (data.lastLoginAt is timestamp && data.lastLoginAt <= request.time));
    }

    // Learning Progress Validation
    function isValidLearningProgress(data) {
      return data.keys().hasAll(['currentChapter', 'currentLevel', 'completedLevels', 'unlockedLevels', 'totalStars', 'totalCompletedLevels']) &&
        data.currentChapter is int && data.currentChapter >= 1 && data.currentChapter <= 5 &&
        data.currentLevel is int && data.currentLevel >= 1 && data.currentLevel <= 10 &&
        data.completedLevels is list &&
        data.unlockedLevels is list &&
        data.totalStars is int && data.totalStars >= 0 &&
        data.totalCompletedLevels is int && data.totalCompletedLevels >= 0 && data.totalCompletedLevels <= 50 &&
        (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    // Daily Activity Validation (Strict Daily Limit: Max 3 Levels/Day)
    function isValidDailyActivity(data) {
      return data.keys().hasAll(['date', 'vocabularyCompleted', 'adventureLevelsCompleted', 'dailyTargetCompleted', 'streakQualified']) &&
        data.date is string && data.date.size() == 10 &&
        data.vocabularyCompleted is int && data.vocabularyCompleted >= 0 &&
        data.adventureLevelsCompleted is int && data.adventureLevelsCompleted >= 0 && data.adventureLevelsCompleted <= 3 &&
        data.dailyTargetCompleted is bool &&
        data.streakQualified is bool &&
        (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    // Daily Vocabulary Rotation Validation
    function isValidDailyVocabulary(data) {
      return data.keys().hasAll(['assignmentDate', 'assignedVocabularyIds', 'totalAssigned', 'completedCount', 'completed']) &&
        data.assignmentDate is string &&
        data.assignedVocabularyIds is list &&
        data.totalAssigned is int && data.totalAssigned > 0 &&
        data.completedCount is int && data.completedCount >= 0 &&
        data.completed is bool;
    }

    // Quiz Result Validation
    function isValidQuizResult(data) {
      return data.keys().hasAll(['chapter', 'level', 'score', 'stars', 'remedialRequired', 'remedialCompleted']) &&
        data.chapter is int && data.chapter >= 1 && data.chapter <= 5 &&
        data.level is int && data.level >= 1 && data.level <= 10 &&
        data.score is int && data.score >= 0 && data.score <= 100 &&
        data.stars is int && data.stars >= 0 && data.stars <= 3 &&
        data.remedialRequired is bool &&
        data.remedialCompleted is bool &&
        (!('completedAt' in data) || (data.completedAt is timestamp && data.completedAt <= request.time));
    }

    // Vocabulary Progress Validation
    function isValidVocabularyProgress(data) {
      return data.keys().hasAll(['vocabularyId', 'word', 'learningStatus', 'reviewCount']) &&
        data.vocabularyId is string &&
        data.word is string &&
        data.learningStatus in ['NEW', 'LEARNING', 'MASTERED', 'NEEDS_REVIEW'] &&
        data.reviewCount is int && data.reviewCount >= 0;
    }

    // User document and private subcollections
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(request.resource.data) && request.resource.data.uid == userId;
      allow update: if isOwner(userId) && isValidUser(request.resource.data) && request.resource.data.uid == resource.data.uid;
      allow delete: if false;

      // Main Learning Progress
      match /learningProgress/{progressId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidLearningProgress(request.resource.data);
        allow delete: if false;
      }

      // Daily Activity Tracking with Server-Enforced Adventure Limit (max 3/day)
      match /dailyActivity/{date} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidDailyActivity(request.resource.data);
        allow delete: if false;
      }

      // Daily Vocabulary Rotation Set
      match /dailyVocabulary/{date} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidDailyVocabulary(request.resource.data);
        allow delete: if false;
      }

      // Quiz Results
      match /quizResults/{resultId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidQuizResult(request.resource.data);
        allow delete: if false;
      }

      // Vocabulary Progress
      match /vocabulary/{vocabId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidVocabularyProgress(request.resource.data);
        allow delete: if false;
      }
    }

    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
