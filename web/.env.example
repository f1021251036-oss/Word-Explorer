# Public Frontend Environment Variables (bundled into browser build)
# NEVER put SMTP_PASSWORD, API secrets, or private keys in /web/.env!

# Google OAuth 2.0 Web Client ID (public identifier for Google Identity Services)
VITE_GOOGLE_WEB_CLIENT_ID=

# Optional API Origin if frontend (/web) and backend (/server) run on different domains.
# Leave empty when using Vite dev proxy or single-container Cloud Run deployment.
VITE_API_BASE_URL=
