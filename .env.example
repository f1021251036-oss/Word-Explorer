# =========================================================
# 1. PUBLIC FRONTEND ENV VARS (Allowed inside browser bundle — copy to /web/.env)
# =========================================================
# VITE_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
# VITE_API_BASE_URL=https://your-api-service.run.app

# =========================================================
# 2. SERVER-ONLY & ANDROID ENV VARS (NEVER prefix with VITE_!)
# =========================================================
PORT=8080
ALLOWED_ORIGIN=https://wordexplorer.example.com
OTP_PEPPER_SECRET=replace-with-long-random-secret-at-least-32-chars

# Google OAuth 2.0 Web Client ID
GOOGLE_WEB_CLIENT_ID=370424798110-1bvllhd3aoqine1scbrou94clcr11ekf.apps.googleusercontent.com

# SMTP Transactional Email Delivery Settings (server-only)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-adventure-app@gmail.com
SMTP_PASSWORD=your-app-password-here
SMTP_FROM_EMAIL=noreply@wordexplorer.app

