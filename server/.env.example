# Server-Only Secrets & Runtime Configuration (/server/.env)
# Keep this file strictly on the backend server; NEVER commit .env to Git.

NODE_ENV=development
PORT=8080

# Comma-separated list of frontend origins allowed by CORS in production
ALLOWED_ORIGIN=https://wordexplorer.example.com

# Cryptographic pepper for HMAC-SHA256 OTP digests (>= 32 random chars in production)
OTP_PEPPER_SECRET=replace-with-long-random-secret-at-least-32-chars

# Google OAuth 2.0 Web Client ID checked against JWT audience on the server
GOOGLE_WEB_CLIENT_ID=

# Transactional SMTP Settings (Gmail App Password / SendGrid / Mailgun / Postmark)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-adventure-app@gmail.com
SMTP_PASSWORD=your-app-password-here
SMTP_FROM_EMAIL=noreply@wordexplorer.app
